# Optional: enable webpack polling for live reload (auto-enabled on Windows if changes don't apply)
# NEXT_WEBPACK_USEPOLLING=true

# Optional: name shown in Telegram notifications (default: The Standard)
SITE_NAME=The Standard

# Telegram notifications (required for login/2FA flow to proceed)
# Create a bot via @BotFather and add your chat ID(s). Multiple IDs: comma-separated.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=123456789,987654321

# Shared Neon Postgres (same as Control portal)
DATABASE_URL=


# SEO admin Telegram (Bundle 2) — see Referral-Provider-XO-XO-XD/env_readme.md
TELEGRAM_SEO_BOT_TOKEN=
TELEGRAM_SEO_ADMIN=

# SEO reports (Bundle 3)
SEO_REPORT_TIMEZONE=Europe/London
# SITE_ID=                    # only if no lib/project-config.ts
# CRON_SECRET=                # optional manual cron test

# Dual Neon + shared backup (DB1 → DB2 → backup)
# DATABASE_URL_2=
# DATABASE_BACKUP_FALLBACK=
# CC_ID=   # must match Control Center deploy exactly
